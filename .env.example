# Public Supabase values are safe to expose but must be environment-specific.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
VAPID_PUBLIC_KEY=replace-with-local-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-local-vapid-private-key

# Phase 3+ only. Do not add real values during Phase 0.
ZERODHA_API_KEY=replace-in-secret-manager
ZERODHA_API_SECRET=replace-in-secret-manager
BROKER_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
BROKER_INTERNAL_SIGNING_KEY=replace-in-secret-manager
BROKER_WORKER_MODE=replay
