{
  "name": "thehrav",
  "version": "0.1.0",
  "private": true,
  "description": "Thehrav: a behavioral circuit breaker for considered investing decisions.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p apps/broker-worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:arch": "vitest run tests/arch",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets && pnpm build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "broker:dev": "pnpm --filter @thehrav/broker-worker dev",
    "broker:build": "pnpm --filter @thehrav/broker-worker build",
    "docker:build": "docker build -t thehrav-web:local .",
    "broker:docker:build": "docker build -f apps/broker-worker/Dockerfile -t thehrav-broker-worker:local ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "dexie": "4.4.6",
    "i18next": "26.4.2",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "server-only": "0.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
